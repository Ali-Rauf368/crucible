# Copy to apps/api/.env (all optional for local dev)
# DATABASE_URL=postgresql://crucible@127.0.0.1:55435/crucible
# REDIS_URL=redis://127.0.0.1:6379          # BullMQ queue (default: PostgreSQL queue)
# MONGO_URL=mongodb://127.0.0.1:27017       # MongoDB trace store (default: PostgreSQL spans table)
# ANTHROPIC_API_KEY=sk-ant-...              # enables the Claude LLM-as-judge and real upstream proxying
# ANTHROPIC_MODEL=claude-opus-5-5
# JUDGE_MODE=auto                           # auto | claude | heuristic
# PRICING_JSON={"claude-opus-5-5":{"in":0,"out":0}}   # set current list prices (USD / 1M tokens) for cost budgets
# JWT_SECRET=change-me-to-a-long-random-string
# CI_TOKEN=                                 # optional bootstrap key accepted for proxy/ci/ingest
# WEBHOOK_ALLOW_PRIVATE=false               # true allows webhooks to private/internal hosts (dev only)
# WORKER=off                                # run API without workers (scale with `npm -w apps/api run worker`)
# WORKER_CONCURRENCY=6
# CASE_TIMEOUT_MS=25000
